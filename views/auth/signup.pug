extends ../layout

block content
  section.cine-auth

    .cine-auth-card
      p.cine-eyebrow JOIN THE COMMUNITY
      h1 Create your account
      p.cine-auth-lead Start building your personal movie library.

      if error
        p.cine-alert.cine-alert-error= error

      form.cine-form(method='POST', action='/signup')
        .cine-field
          label.cine-label(for='username') Username
          input.cine-input(type='text', id='username', name='username', required, minlength='3', maxlength='30', autocomplete='username')

        .cine-field
          label.cine-label(for='email') Email
          input.cine-input(type='email', id='email', name='email', required, autocomplete='email')

        .cine-field
          label.cine-label(for='password') Password
          input.cine-input(type='password', id='password', name='password', required, minlength='8', autocomplete='new-password')
          p.cine-help At least 8 characters.

        button.cine-button-primary(type='submit') Create account

      p.cine-auth-footer Already have an account? #[a(href='/login') Login]
