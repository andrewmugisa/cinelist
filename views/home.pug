extends layout
block content
  section.cine-hero
    .cine-hero-copy
      p.cine-eyebrow YOUR MOVIE JOURNAL
      h1 Every movie.<br> #[span Your story.]
      p Keep track of what you've watched, what you loved, and what you want to see next.
      .cine-hero-actions
        if currentUser
          a.btn-emp-primary(href='/search?q=') Explore movies
        else
          a.btn-emp-primary(href='/signup') Start your list
          a.btn-emp-secondary(href='/login') Sign in
    .cine-hero-art
      .cine-art-caption THE NEXT GREAT FILM IS OUT THERE.
  section.cine-section
    .cine-section-heading
      div
        p.cine-eyebrow DISCOVER
        h2 Popular movies
      form.cine-search(method='GET', action='/search')
        input(type='search', name='q', placeholder='Search movies...', aria-label='Search movies', required)
        button.btn-emp-primary(type='submit') Search
    if tmdbError
      p.emp-alert.emp-alert-error= tmdbError
    if movies.length
      .cine-grid
        each movie in movies
          a.cine-movie-card(href='/search?q=' + encodeURIComponent(movie.title))
            if movie.poster_path
              img.cine-poster(src='https://image.tmdb.org/t/p/w500' + movie.poster_path, alt=movie.title + ' poster', loading='lazy')
            else
              .cine-no-poster No poster
            .cine-movie-info
              h3= movie.title
              p= movie.release_date ? movie.release_date.slice(0, 4) : 'Release date unknown'
              if movie.vote_average
                span.cine-rating ★ #{movie.vote_average.toFixed(1)}
    else if !tmdbError
      p No movie results were returned.
  section.cine-feature-row
    article
      h3 Track your watch history
      p Keep a personal list and mark movies as completed, watching, on hold, or dropped.
    article
      h3 Rate what you watch
      p Give movies your own score and keep your thoughts alongside them.
    article
      h3 Find your next favourite
      p Browse and search the movie catalogue to plan your next watch.
