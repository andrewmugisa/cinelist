header.cine-nav
  a.cine-brand(href='/') CineList

  //- search type dropdown
  form.cine-search(method='GET', action='/search')
    select.cine-search-type(name='type', aria-label='Search category')
      option(value='movie', selected=searchType !== 'user') Movies
      option(value='user', selected=searchType === 'user') Users
    
    //- search bar 
    input(type='search', name='q', placeholder='Search...', aria-label='Search', value=searchQuery || '', required)

    //- search button 
    button.cine-search-submit(type='submit', aria-label='Submit search')
      img(src='/images/search-button.svg', alt='')


  nav.cine-nav-links
    if currentUser
      //- settings 
      a.cine-settings-link(href='/settings', aria-label='Settings', title='Settings')
        img(src='/images/settings.svg', alt='settings')
      
      //- username and dropdown 
      details.cine-user-menu
        summary= currentUser.username
        .cine-user-dropdown
          a(href='/profile') Profile
          a(href='/list') List
          form(method='POST', action='/logout')
            button(type='submit') Logout

      //- pfp 
      a.cine-nav-avatar(href='/profile', aria-label='Your profile')
        if currentUser.profilePicture
          img(src=currentUser.profilePicture, alt=currentUser.username + ' profile picture')
        else
          img(src='../images/avatar-default.svg', alt='Default profile picture')
    else
      a.cine-login-link(href='/login') Login
      a.cine-signup-link(href='/signup') Sign up
