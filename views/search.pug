extends layout

block content
  section.cine-section
    .cine-section-heading
      div
        p.cine-eyebrow MOVIE SEARCH
        h1 Results for “#{query}”
      form.cine-search(method='GET', action='/search')
        input(type='hidden', name='type', value='movie')
        input(type='search', name='q', value=query, required, aria-label='Search movies')
        button.btn-emp-primary(type='submit') Search

    if tmdbError
      p.emp-alert.emp-alert-error= tmdbError

    if movies && movies.length
      .cine-grid
        each movie in movies
          include partials/movie-card
    else
      p No results found.
