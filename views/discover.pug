extends layout

block pageStyles
  link(rel='stylesheet', href='/css/discover.css')

block content
  section.cine-section.cine-discover
    .cine-section-heading
      div
        p.cine-eyebrow DISCOVER
        h1= heading

      a.cine-button.cine-button-secondary(href='/') Back to home

    if tmdbError
      p.cine-alert.cine-alert-error= tmdbError

    if movies && movies.length
      .cine-discover-grid
        each movie in movies
          include partials/movie-card

      nav.cine-pagination(aria-label='Movie pages')
        if page > 1
          a.cine-button.cine-button-secondary(
            href='/discover/' + category + '?page=' + (page - 1)
          ) Previous
        else
          button.cine-button.cine-button-secondary(type='button' disabled) Previous

        span.cine-pagination-info
          | Page #{page} of #{totalPages}

        if hasNextPage
          a.cine-button.cine-button-primary(
            href='/discover/' + category + '?page=' + (page + 1)
          ) Next
        else
          button.cine-button.cine-button-primary(type='button' disabled) Next
    else
      p No movies found in this category.