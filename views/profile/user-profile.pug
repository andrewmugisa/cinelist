
extends ../layout

block pageStyles
  link(rel='stylesheet', href='/css/profile.css')

block content
  .cine-profile

    //- Profile background
    header.cine-profile-banner

    .cine-profile-layout

      //- Left profile sidebar
      aside.cine-profile-sidebar
        .cine-profile-avatar
          span= profileUser.username.charAt(0).toUpperCase()

        h2.cine-profile-username= profileUser.username

        .cine-profile-meta
          .cine-profile-meta-item
            span Member since
            strong= joinedDate || 'Unknown'

          .cine-profile-meta-item
            span Last online
            strong= lastOnline || 'Unknown'

        .cine-profile-actions
          a.cine-button.cine-button-primary(
            href='/user/' + encodeURIComponent(profileUser.username) + '/list'
          ) View List

          if isOwnProfile
            a.cine-button.cine-button-secondary(href='/settings') Edit Profile

        //- Statistics below profile picture
        .cine-profile-stats
          h3 Collection Statistics

          .cine-profile-stat
            span Plan to Watch
            strong= listCounts['Plan to Watch'] || 0

          .cine-profile-stat
            span Watching
            strong= listCounts.Watching || 0

          .cine-profile-stat
            span Completed
            strong= listCounts.Completed || 0

          .cine-profile-stat
            span On Hold
            strong= listCounts['On Hold'] || 0

          .cine-profile-stat
            span Dropped
            strong= listCounts.Dropped || 0

      //- Main profile content
      main.cine-profile-main

        //- Two main sections side by side
        .cine-profile-primary-grid

          //- Currently Watching
          section.cine-profile-section
            .cine-profile-section-heading
              h2 Currently Watching
              span.cine-profile-count #{currentlyWatching.length} / 5

            if currentlyWatching.length
              .cine-profile-movie-grid
                each movie in currentlyWatching
                  a.cine-profile-movie(href='/movies/' + movie.movieId)
                    if movie.posterPath
                      img(
                        src='https://image.tmdb.org/t/p/w500' + movie.posterPath
                        alt=movie.title + ' poster'
                        loading='lazy'
                      )
                    else
                      .cine-profile-no-poster No poster

                    .cine-profile-movie-info
                      h3= movie.title
                      if movie.score
                        span.cine-profile-score ★ #{movie.score}/10
            else
              .cine-profile-empty
                p No movies currently being watched.
                if isOwnProfile
                  a(href='/discover/popular') Discover movies

          //- Recently Completed
          section.cine-profile-section
            .cine-profile-section-heading
              h2 Recently Completed
              span.cine-profile-count #{recentlyCompleted.length} / 5

            if recentlyCompleted.length
              .cine-profile-movie-grid
                each movie in recentlyCompleted
                  a.cine-profile-movie(href='/movies/' + movie.movieId)
                    if movie.posterPath
                      img(
                        src='https://image.tmdb.org/t/p/w500' + movie.posterPath
                        alt=movie.title + ' poster'
                        loading='lazy'
                      )
                    else
                      .cine-profile-no-poster No poster

                    .cine-profile-movie-info
                      h3= movie.title
                      if movie.score
                        span.cine-profile-score ★ #{movie.score}/10
            else
              .cine-profile-empty
                p No completed movies yet.
                if isOwnProfile
                  a(href='/discover/popular') Find something to watch

          //- favourites section
          section.cine-profile-favorites
            .cine-profile-section-heading
              h2 Favourite Movies
              span.cine-profile-count #{favoriteMovies.length} / 10

            if favoriteMovies.length
              .cine-profile-favorites-grid
                each movie in favoriteMovies
                  a.cine-profile-movie(href='/movies/' + movie.movieId)
                    if movie.posterPath
                      img(
                        src='https://image.tmdb.org/t/p/w500' + movie.posterPath
                        alt=movie.title + ' poster'
                        loading='lazy'
                      )
                    else
                      .cine-profile-no-poster No poster

                    .cine-profile-movie-info
                      h3= movie.title
            else
              .cine-profile-empty
                p No favourite movies added yet.
                if isOwnProfile
                  a(href='/settings') Choose your favourite movies
